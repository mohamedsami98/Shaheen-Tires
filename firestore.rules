rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict verified admin check locked exclusively to shaheeninfo96@gmail.com
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'shaheeninfo96@gmail.com';
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'brandName', 'brandTagline', 'logoUrl', 'primaryColor', 'surfaceMode',
          'accentStyle', 'whatsappFloatNumber', 'whatsappFloatEnabled',
          'paymentInstructions', 'beneficiaryWarning', 'sectionOrder',
          'sectionVisibility', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'brandName', 'brandTagline', 'logoUrl', 'primaryColor', 'surfaceMode',
          'accentStyle', 'whatsappFloatNumber', 'whatsappFloatEnabled',
          'paymentInstructions', 'beneficiaryWarning', 'sectionOrder',
          'sectionVisibility', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 120
        && data.brandTagline is string && data.brandTagline.size() <= 400
        && data.logoUrl is string && data.logoUrl.size() <= 250000
        && data.primaryColor is string && data.primaryColor.size() <= 7 && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$')
        && data.surfaceMode is string && data.surfaceMode.size() <= 10 && data.surfaceMode in ['light', 'dark']
        && data.accentStyle is string && data.accentStyle.size() <= 20 && data.accentStyle in ['emerald', 'gold', 'navy', 'obsidian', 'custom']
        && data.whatsappFloatNumber is string && data.whatsappFloatNumber.size() <= 30
        && data.whatsappFloatEnabled is bool
        && data.paymentInstructions is string && data.paymentInstructions.size() <= 600
        && data.beneficiaryWarning is string && data.beneficiaryWarning.size() <= 600
        && data.sectionOrder is list && data.sectionOrder.size() == 4
        && data.sectionOrder[0] is string
        && data.sectionOrder.hasOnly(['social', 'branches', 'wallets', 'banks'])
        && data.sectionVisibility is map
        && data.sectionVisibility.keys().hasAll(['social', 'branches', 'wallets', 'banks'])
        && data.sectionVisibility.keys().hasOnly(['social', 'branches', 'wallets', 'banks'])
        && data.sectionVisibility.social is bool
        && data.sectionVisibility.branches is bool
        && data.sectionVisibility.wallets is bool
        && data.sectionVisibility.banks is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidSocialLink(data, docId) {
      return data.keys().hasAll([
          'id', 'platform', 'label', 'url', 'subtitle', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'platform', 'label', 'url', 'subtitle', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && data.platform is string && data.platform.size() <= 20
        && data.platform in ['facebook', 'instagram', 'tiktok', 'whatsapp', 'telegram', 'youtube', 'website', 'x', 'linkedin', 'snapchat']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500
        && data.subtitle is string && data.subtitle.size() <= 200
        && data.visible is bool
        && data.order is number && data.order >= 0 && data.order <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidBranchLocation(data, docId) {
      return data.keys().hasAll([
          'id', 'name', 'address', 'mapUrl', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'address', 'mapUrl', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 300
        && data.mapUrl is string && data.mapUrl.size() >= 1 && data.mapUrl.size() <= 500
        && data.visible is bool
        && data.order is number && data.order >= 0 && data.order <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidWalletAccount(data, docId) {
      return data.keys().hasAll([
          'id', 'provider', 'providerName', 'identifier', 'ownerName',
          'showOwnerName', 'note', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'provider', 'providerName', 'identifier', 'ownerName',
          'showOwnerName', 'note', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && data.provider is string && data.provider.size() <= 20
        && data.provider in ['vodafone', 'orange', 'etisalat', 'wepay', 'instapay', 'other']
        && data.providerName is string && data.providerName.size() >= 1 && data.providerName.size() <= 80
        && data.identifier is string && data.identifier.size() >= 1 && data.identifier.size() <= 120
        && data.ownerName is string && data.ownerName.size() <= 120
        && data.showOwnerName is bool
        && data.note is string && data.note.size() <= 300
        && data.visible is bool
        && data.order is number && data.order >= 0 && data.order <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    function isValidBankAccount(data, docId) {
      return data.keys().hasAll([
          'id', 'bankName', 'accountHolder', 'accountNumber', 'iban',
          'currency', 'branchName', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'bankName', 'accountHolder', 'accountNumber', 'iban',
          'currency', 'branchName', 'visible', 'order',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && data.bankName is string && data.bankName.size() >= 1 && data.bankName.size() <= 120
        && data.accountHolder is string && data.accountHolder.size() >= 1 && data.accountHolder.size() <= 120
        && data.accountNumber is string && data.accountNumber.size() >= 1 && data.accountNumber.size() <= 80
        && data.iban is string && data.iban.size() <= 80
        && data.currency is string && data.currency.size() <= 30
        && data.branchName is string && data.branchName.size() <= 120
        && data.visible is bool
        && data.order is number && data.order >= 0 && data.order <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create: if isValidId(configId)
        && isAdmin()
        && isValidSiteConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;
      allow update: if isValidId(configId)
        && isAdmin()
        && isValidSiteConfig(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName', 'brandTagline', 'logoUrl', 'primaryColor', 'surfaceMode',
          'accentStyle', 'whatsappFloatNumber', 'whatsappFloatEnabled',
          'paymentInstructions', 'beneficiaryWarning', 'sectionOrder',
          'sectionVisibility', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(configId) && isAdmin();
    }

    match /socialLinks/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if true;
      allow create: if isValidId(linkId)
        && isAdmin()
        && isValidSocialLink(incoming(), linkId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;
      allow update: if isValidId(linkId)
        && isAdmin()
        && isValidSocialLink(incoming(), linkId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'platform', 'label', 'url', 'subtitle', 'visible', 'order', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(linkId) && isAdmin();
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId);
      allow list: if true;
      allow create: if isValidId(branchId)
        && isAdmin()
        && isValidBranchLocation(incoming(), branchId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;
      allow update: if isValidId(branchId)
        && isAdmin()
        && isValidBranchLocation(incoming(), branchId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'address', 'mapUrl', 'visible', 'order', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(branchId) && isAdmin();
    }

    match /wallets/{walletId} {
      allow get: if isValidId(walletId);
      allow list: if true;
      allow create: if isValidId(walletId)
        && isAdmin()
        && isValidWalletAccount(incoming(), walletId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;
      allow update: if isValidId(walletId)
        && isAdmin()
        && isValidWalletAccount(incoming(), walletId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'provider', 'providerName', 'identifier', 'ownerName',
          'showOwnerName', 'note', 'visible', 'order', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(walletId) && isAdmin();
    }

    match /bankAccounts/{bankId} {
      allow get: if isValidId(bankId);
      allow list: if true;
      allow create: if isValidId(bankId)
        && isAdmin()
        && isValidBankAccount(incoming(), bankId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid;
      allow update: if isValidId(bankId)
        && isAdmin()
        && isValidBankAccount(incoming(), bankId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'bankName', 'accountHolder', 'accountNumber', 'iban',
          'currency', 'branchName', 'visible', 'order', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(bankId) && isAdmin();
    }
  }
}
